# Adapters and Event infrastructure classes.
# Note: MqttPublisher exists in adapters/mqtt_publisher.py but is NOT instantiated
# by build_dependencies() — it's standalone code not wired into the running system.
# Included here for completeness with a note.
# Render: d2 06-adapters-events-class.d2 adapters-events-class.svg

EventStore: {
  shape: class
  -_events: deque
  -_subscribers: set
  -_subscriber_queue_size: int
  +append(event_type, **kwargs)
  +subscribe(): asyncio.Queue
  +unsubscribe(queue)
  +list_events(page, page_size, filter_text, filter_mode): tuple
  +size(): int
  +clear()
}

EventBridge: {
  shape: class
  -_mode: str
  -_target_url: str?
  -_logger: Logger
  +emit(event)
}

DistancePublisher: {
  shape: class
  -_broker_url: str?
  -_event_store: EventStore
  -_logger: Logger
  -_message_id: int
  +publish(sensor, distance)
  -_build_payload(sensor, distance): dict
}

KafkaObserver: {
  shape: class
  +event_store: EventStore
  +logger: Logger
  +bootstrap_servers: str
  +group_id: str
  +topics: tuple
  -_consumer: AIOKafkaConsumer?
  -_task: asyncio.Task?
  -_running: bool
  +start()
  +stop()
  -_run()
  -_consume_loop()
  -_record_event(record)
}

MqttPublisher: {
  shape: class
  # (NOT wired in deps.py — defined but unused at runtime)
  +hostname: str
  +port: int
  +event_store: EventStore
  +logger: Logger
  -_message_id: int
  +publish(topic, payload)
}

DistancePublisher -> EventStore: "append MQTT events"
KafkaObserver     -> EventStore: "append KAFKA events"
MqttPublisher     -> EventStore: "would append MQTT events (if wired)"
EventBridge       -> EventStore: "optional external relay"
