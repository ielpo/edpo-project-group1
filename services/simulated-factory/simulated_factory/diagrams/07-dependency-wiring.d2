# Dependency wiring as performed by build_dependencies() in deps.py.
# Reflects what is actually instantiated at startup.
# Render: d2 07-dependency-wiring.d2 dependency-wiring.svg

direction: down

main:    "main.py"
api:     "api.py / create_app()"
deps:    "deps.py / build_dependencies()"

event_store:      "EventStore"
mqtt_publisher:   "MqttPublisher"
sensor_registry:  "SensorRegistry"
actuator_registry:"ActuatorRegistry"
inventory_poller: "InventoryPoller"
engine:           "SimulationEngine"
kafka_observer:   "KafkaObserver"
snapshot:         "RuntimeSnapshot"

config:    "config.yml"
sensors:   "Sensor Plugins"
kafka:     "Kafka Topics"
mqtt:      "MQTT Broker"
inventory: "Inventory Service"

main -> api: "create_app(config_path)"
api  -> deps: "build_dependencies(...)"

deps -> event_store
deps -> mqtt_publisher
deps -> sensor_registry
deps -> actuator_registry
deps -> inventory_poller
deps -> engine
deps -> kafka_observer

# api.py additionally constructs RuntimeSnapshot
api -> snapshot: "composes view layer"

# Internal wiring
mqtt_publisher   -> event_store: "logs publishes"
sensor_registry  -> config: "loads YAML"
sensor_registry  -> sensors: "instantiates via importlib"
sensor_registry  -> mqtt_publisher: "wires into MqttSensors"
engine           -> sensor_registry: "delegates sensor ops"
engine           -> actuator_registry: "delegates actuator ops"
engine           -> event_store: "appends events"
engine           -> mqtt_publisher: "receives (unused directly)"
snapshot         -> engine: "reads lifecycle"
snapshot         -> sensor_registry: "reads configs"
snapshot         -> actuator_registry: "reads states"
snapshot         -> inventory_poller: "reads cache"
snapshot         -> event_store: "reads events"

# External connections
kafka_observer   -> kafka: "consumes"
kafka_observer   -> event_store: "appends KAFKA events"
inventory_poller -> inventory: "polls /inventory"
mqtt_publisher   -> mqtt: "publishes (when broker configured)"
