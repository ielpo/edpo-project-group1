# Engine class diagram: facade, runtime state holders, and the three domain managers.
# Render: d2 03-engine-class.d2 engine-class.svg

SimulationEngine: {
  shape: class

  +event_store: EventStore
  +distance_publisher: DistancePublisher
  +event_bridge: Any
  -_runtime: SimulationRuntime
  -_resource_mgr: ResourceManager
  -_process_runner: ProcessRunner
  -_control_mgr: ControlPointManager

  +get_status(): SimulationState
  +list_presets(): list
  +run_preset(preset_name, speed): str
  +stop()
  +reset()
  +fire_gate_if_matches(method, path): bool
  +handle_dobot_commands(robot, payload): dict
  +resolve_action(action_id, outcome, reason): PendingAction
  +get_pending_actions(): list
  +get_interactive_config(): InteractiveConfig
  +set_interactive_config(cfg): InteractiveConfig
  +get_sensor_configs(): list
  +update_sensor(sensor_id, update): SensorConfig
  +read_color(robot): tuple
  +read_ir(robot): bool
  +read_color_sensor_bytes(): dict
  +get_dobot_state(robot): DobotRuntimeState
  +get_inventory_cache(): dict
  +start_inventory_poller()
  +stop_inventory_poller()
  +record_external_event(payload)
}

SimulationRuntime: {
  shape: class
  +factory: FactoryState
  +process: ProcessState
  +control: ControlState
  +resources: PhysicalResources
  +reset()
}

FactoryState: {
  shape: class
  +run_id: str
  +status: SimulationStatus
  +current_preset: str?
  +run_counter: int
  +stop_requested: bool
  +run_task: asyncio.Task?
  +lock: asyncio.Lock
}

ProcessState: {
  shape: class
  +current_step: int
  +current_step_name: str?
  +presets: dict
}

ControlState: {
  shape: class
  +step_gate: tuple?
  +waiting_for_request: AwaitRequest?
  +interactive_config: InteractiveConfig
  +pending: dict
  +pending_counter: int
}

PhysicalResources: {
  shape: class
  +default_sensors: dict
  +sensors: dict
  +dobots: dict
  +inventory_cache: dict?
  +inventory_poll_task: asyncio.Task?
}

ProcessRunner: {
  shape: class

  -_factory: FactoryState
  -_process: ProcessState
  -_control: ControlState
  -_resources: PhysicalResources
  -_event_store: EventStore
  -_distance_publisher: DistancePublisher

  +list_presets(): list
  +run_preset(preset_name, speed): str
  -_execute_preset(preset, speed)
  -_await_step_gate(step, speed)
  -_apply_step_side_effects_sync(step)
  -_publish_distance_if_needed(step)
  -_clear_step_gate()
}

ControlPointManager: {
  shape: class

  -_factory: FactoryState
  -_process: ProcessState
  -_control: ControlState
  -_resources: PhysicalResources
  -_event_store: EventStore

  +fire_gate_if_matches(method, path)
  +matches_gate(method, path): bool
  +handle_dobot_commands(robot, payload): dict
  +resolve_action(action_id, outcome, reason): PendingAction
  +get_pending_actions(): list
  +get_interactive_config(): InteractiveConfig
  +set_interactive_config(cfg): InteractiveConfig
  -_apply_gate_side_effects(step)
  -_apply_commands(robot, commands)
}

ResourceManager: {
  shape: class

  -_resources: PhysicalResources
  -_event_store: EventStore
  -_config_path: Path
  -_inventory_url: str

  +get_presets(): dict
  +sensor_map_for_preset(preset): dict
  +get_sensor_configs(): list
  +update_sensor(sensor_id, update): SensorConfig
  +read_color(robot): tuple
  +read_ir(robot): bool
  +read_color_sensor_bytes(): dict
  +get_dobot_state(robot): DobotRuntimeState
  +get_inventory_cache(): dict
  +start_inventory_poller()
  +stop_inventory_poller()
  +set_current_step_getter(getter)
  +make_plugin(sensor_id, cfg): BaseSensor
  -_load_config()
  -_make_plugin(sensor_id, cfg): BaseSensor
  -_infer_sensor_type(sensor_id, cfg): str
  -_inventory_poll_loop()
}

_MutableStateProxy: {
  shape: class

  # Backward-compat shim exposed via SimulationEngine.state.
  # All fields are proxied to SimulationRuntime.
  -_rt: SimulationRuntime
  +id: str
  +status: SimulationStatus
  +currentPreset: str?
  +currentStep: int
  +currentStepName: str?
  +timestamp: datetime
  +dobots: dict
  +waitingForRequest: AwaitRequest?
  +model_copy(deep): SimulationState
}

# Composition: SimulationEngine owns runtime + managers
SimulationEngine     -> SimulationRuntime:    "owns"
SimulationEngine     -> ProcessRunner:        "owns"
SimulationEngine     -> ControlPointManager:  "owns"
SimulationEngine     -> ResourceManager:      "owns"
SimulationEngine     -> _MutableStateProxy:   "returns via .state"

SimulationRuntime    -> FactoryState:         "owns"
SimulationRuntime    -> ProcessState:         "owns"
SimulationRuntime    -> ControlState:         "owns"
SimulationRuntime    -> PhysicalResources:    "owns"

# Managers share references to runtime sub-states (not ownership)
ProcessRunner        -> FactoryState:         "ref"
ProcessRunner        -> ProcessState:         "ref"
ProcessRunner        -> ControlState:         "ref"
ProcessRunner        -> PhysicalResources:    "ref"

ControlPointManager  -> FactoryState:         "ref"
ControlPointManager  -> ProcessState:         "ref"
ControlPointManager  -> ControlState:         "ref"
ControlPointManager  -> PhysicalResources:    "ref"

ResourceManager      -> PhysicalResources:    "ref"
